#!/usr/bin/bash
# Sync an Omarchy setup to a private GitHub repository.
# 薄 wrapper:清洗环境(安全边界)→ 按需持锁 → 以 /usr/bin/lua 启动 src/main.lua。
# 业务逻辑全部在 src/*.lua(中文注释)。

set -euo pipefail

# Drop inherited loader, shell, and PATH state before any Lua code runs.
# Automatic callers start this through a cleared environment;
# a direct invocation re-execs itself the same way.
if [[ ${OMARSYNC_SANITIZED:-} != 1 ]]; then
  home=${HOME:-}
  [[ $home == /* && $home != *$'\n'* && $home != *:* ]] || {
    printf 'omarsync: HOME must be an absolute path\n' >&2
    exit 1
  }
  user=$(/usr/bin/id -un)
  uid=$(/usr/bin/id -u)
  runtime="/run/user/${uid}"
  origin=${OMARSYNC_ORIGIN:-}
  dot_origin=${OMARSYNC_DOT_ORIGIN:-}
  keep_origin=""
  keep_dot_origin=""
  if [[ $origin == /* && $origin != *..* && $origin != *[[:space:]]* ]]; then
    keep_origin=$origin
  fi
  if [[ $dot_origin == /* && $dot_origin != *..* && $dot_origin != *[[:space:]]* ]]; then
    keep_dot_origin=$dot_origin
  fi
  root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
  vars=(
    "HOME=${home}"
    "USER=${user}"
    "LOGNAME=${user}"
    "PATH=/usr/bin:/bin:/usr/sbin:/usr/share/omarchy/bin"
    "LANG=C.UTF-8"
    "LC_ALL=C.UTF-8"
    "OMARCHY_PATH=/usr/share/omarchy"
    "OMARSYNC_SANITIZED=1"
    "OMARSYNC_ROOT=${root}"
    "GIT_TERMINAL_PROMPT=0"
    "GIT_EDITOR=/usr/bin/true"
    "GH_PROMPT_DISABLED=1"
  )
  [[ -d $runtime ]] && vars+=("XDG_RUNTIME_DIR=${runtime}")
  [[ ${OMARSYNC_SKIP_LIVE:-} == 1 ]] && vars+=("OMARSYNC_SKIP_LIVE=1")
  [[ -n $keep_origin ]] && vars+=("OMARSYNC_ORIGIN=${keep_origin}")
  [[ -n $keep_dot_origin ]] && vars+=("OMARSYNC_DOT_ORIGIN=${keep_dot_origin}")
  exec /usr/bin/env -i "${vars[@]}" /usr/bin/bash "$0" "$@"
fi

export PATH="/usr/bin:/bin:/usr/sbin:/usr/share/omarchy/bin"
export GIT_TERMINAL_PROMPT=0
export GIT_EDITOR=/usr/bin/true
export GH_PROMPT_DISABLED=1
unset LD_PRELOAD LD_LIBRARY_PATH BASH_ENV ENV IFS CDPATH PYTHONPATH NODE_OPTIONS \
  PERL5OPT RUBYOPT GIT_EXEC_PATH GIT_SSH GIT_SSH_COMMAND GIT_CONFIG_PARAMETERS \
  GIT_CONFIG_COUNT GH_TOKEN GITHUB_TOKEN SSH_AUTH_SOCK MISE_CONFIG_FILE || true

ROOT=${OMARSYNC_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}

# 自愈 shim:Omarchy 插件系统不会把插件的 bin/ 放进 PATH,
# 但面板每次状态扫描都会跑到这里——趁机把 ~/.local/bin/omarsync 补上。
# 只在自己创建的文件上更新,绝不覆盖用户已有的同名文件。
shim="${HOME}/.local/bin/omarsync"
shim_body="#!/bin/sh
exec \"\$HOME/.config/omarchy/plugins/io.github.lukebest.omarsync/bin/omarsync\" \"\$@\""
if [[ $ROOT == "$HOME/.config/omarchy/plugins/"* ]]; then
  if [[ ! -e $shim ]]; then
    /usr/bin/mkdir -p "${HOME}/.local/bin"
    printf '%s\n' "$shim_body" >"$shim"
    /usr/bin/chmod 755 "$shim"
  elif [[ -f $shim && ! -L $shim ]] && /usr/bin/grep -q 'omarchy/plugins/io.github.lukebest.omarsync/bin/omarsync' "$shim" 2>/dev/null; then
    printf '%s\n' "$shim_body" >"$shim"
    /usr/bin/chmod 755 "$shim"
  fi
fi

# lua 必须来自不可写的系统目录;不接受用户目录里的副本
LUA_BIN=""
for candidate in /usr/bin/lua /bin/lua; do
  if [[ -x $candidate && ! -w $candidate ]]; then
    LUA_BIN=$candidate
    break
  fi
done
[[ -n $LUA_BIN ]] || {
  printf 'omarsync: trusted lua not found. Run: omarchy pkg add lua\n' >&2
  exit 1
}

# 写操作命令在执行前持锁(整个进程生命周期);status 等只读命令不取锁
case "${1:-status}" in
  push|pull|apply|sync|migrate)
    state="${HOME}/.local/state/omarsync"
    /usr/bin/mkdir -p "$state"
    exec 9>"${state}/omarsync.lock"
    if ! /usr/bin/flock -n 9; then
      printf 'omarsync: another omarsync operation is running\n' >&2
      exit 1
    fi
    ;;
esac

exec "$LUA_BIN" "${ROOT}/src/main.lua" "$@"
